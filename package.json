    "Timmy Kouadio-Bhegnin <kouadiobhegnino@gmail.com> (https://abjshawty.dev)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abjshawty/http.git"
  },
  "bugs": {
    "url": "https://github.com/abjshawty/http/issues",
    "email": "dev@abjshawty.dev"
  },
  "homepage": "https://github.com/abjshawty/http?path=/README.md",
  "dependencies": {
    "@elysia/openapi": "1.4.16",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "1.4.30",
    "pg": "^8.23.1",
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun",
  "engineStrict": true,
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "format": "prettier --write ./src",
    "db:ensure": "bun src/db/ensure.ts",
    "db:push": "bun db:ensure && bunx --bun drizzle-kit push"
  }
}
