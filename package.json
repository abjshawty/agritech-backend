{
  "name": "agritech-backend",
  "description": "AGRITECH API: crop suitability for Côte d'Ivoire from NASA POWER climate and SoilGrids soil data. Team AKOMA, NASA Space Apps Challenge.",
  "version": "0.1.0",
  "type": "module",
  "module": "src/index.ts",
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Timmy Kouadio-Bhegnin",
    "email": "kouadiobhegnino@gmail.com",
    "url": "https://www.abjshawty.dev"
  },
  "contributors": [
    "Timmy Kouadio-Bhegnin <kouadiobhegnino@gmail.com> (https://abjshawty.dev)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abjshawty/agritech-backend.git"
  },
  "bugs": {
    "url": "https://github.com/abjshawty/agritech-backend/issues"
  },
  "homepage": "https://github.com/abjshawty/agritech-backend?path=/README.md",
  "dependencies": {
    "@elysia/openapi": "1.4.16",
    "elysia": "1.4.30",
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "geotiff": "^3.0.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun",
  "engineStrict": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --hot src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit -p .",
    "format": "prettier --write ./src",
    "soil:build": "bun scripts/build-soil.ts",
    "snapshots:build": "bun scripts/build-snapshots.ts",
    "gaez:build": "bun scripts/build-gaez.ts",
    "crops:build": "bun scripts/build-crops.ts",
    "gaez:compare": "bun scripts/compare-gaez.ts",
    "e2e": "bun scripts/e2e.ts"
  }
}
